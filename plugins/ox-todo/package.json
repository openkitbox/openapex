{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ox-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders ox's two-level todo list (metadata.phases) in the opencode TUI sidebar.",
  "exports": {
    "./tui": "./tui.tsx"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true },
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.1",
    "@opencode/theme": "2.1.1",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.3",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  }
}
